{
  "compilerOptions": {
    "target": "ES2022",
    // 產物由 esbuild 打包，tsc 只做型別檢查——所以用 Bundler 解析（相對
    // 匯入不必寫 .js 副檔名），並且永不 emit。
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // 前端程式碼本身不該碰 Node，但 `src/protocol.ts` 順著 core 的協議定義
    // 會解析到 fileTree/logger 那幾個 Node 側模組，少了 node 型別它們自己
    // 就編譯不過。真正擋住「前端誤用 Node API」的是 esbuild：產物按
    // platform: 'browser' 打包，import 'node:path' 會直接解析失敗。
    "types": ["node"]
  },
  // ../src/core/protocol/index.ts 由 src/protocol.ts 以 `import type` 引入，
  // tsc 會順著解析進去，不必在 include 裡點名。
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
