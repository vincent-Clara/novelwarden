# 映象在容器裡自己 npm ci、自己出前端產物，宿主機上的這些只會拖慢上下文、還可能是別的架構。
# 其餘與 .gitignore 對齊：構建產物、本機私有目錄一律不進構建上下文。
.git
node_modules
dist
out
*.vsix
*.db
*.db-wal
*.db-shm
.claude
.cursor
.worktrees
temp
local
src/shells/standalone/mediaAssets.ts
src/core/skills/builtin/embedded.ts
src/shells/desktop/target
src/shells/desktop/binaries
# Android 殼（Java + gradle，構建時還會放進 90 MB 的 node）與映象無關
src/shells/android
sample-novel/.novelwarden/sessions
sample-novel/.novelforge/sessions
