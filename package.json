{
  "name": "novelwarden",
  "displayName": "Novelwarden — 小說寫作：自動整理細綱、角色卡、設定",
  "description": "寫長篇小說、網文用：照正文自動整理每章細綱、角色卡、世界觀設定、劇情線和伏筆，不用手動維護；也能用 AI 續寫，支援 OpenAI、Claude 和 Copilot 的模型。Long-form novel writing: auto-maintained chapter outlines, character sheets, worldbuilding and plot threads, plus AI drafting.",
  "version": "0.2.15",
  "publisher": "novelwarden",
  "icon": "media/icon.png",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/noir017/novelwarden.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "小說",
    "寫小說",
    "小說寫作",
    "小說創作",
    "長篇小說",
    "網文",
    "網路小說",
    "寫作",
    "大綱",
    "細綱",
    "章綱",
    "角色卡",
    "人物設定",
    "世界觀",
    "設定集",
    "伏筆",
    "續寫",
    "AI寫作",
    "AI寫小說",
    "novel",
    "fiction",
    "writing",
    "creative writing",
    "story",
    "outline",
    "worldbuilding",
    "characters",
    "ai"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.novelwarden/project.json",
    "workspaceContains:.novelforge/project.json",
    "workspaceContains:.novel/project.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "novelForge",
          "title": "Novelwarden",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "novelForge": [
        {
          "id": "novelForge.chat",
          "name": "Novelwarden",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "novel.initProject",
        "title": "Novel: 初始化小說工程",
        "icon": "$(new-folder)"
      },
      {
        "command": "novel.refresh",
        "title": "Novel: 重新整理",
        "icon": "$(refresh)"
      },
      {
        "command": "novel.newPlot",
        "title": "Novel: 新建細綱",
        "icon": "$(add)"
      },
      {
        "command": "novel.setApiKey",
        "title": "Novel: 設定 API Key"
      },
      {
        "command": "novel.clearApiKey",
        "title": "Novel: 清除 API Key"
      },
      {
        "command": "novel.selectModel",
        "title": "Novel: 選擇模型"
      },
      {
        "command": "novel.continue",
        "title": "Novel: 開啟續寫對話",
        "icon": "$(sparkle)"
      },
      {
        "command": "novel.openChatInEditor",
        "title": "Novel: 在編輯器中開啟對話面板",
        "icon": "$(link-external)"
      },
      {
        "command": "novel.newSession",
        "title": "Novel: 新建對話",
        "icon": "$(add)"
      },
      {
        "command": "novel.addSelectionToChat",
        "title": "Novel: 將選中文字加入對話上下文"
      },
      {
        "command": "novel.openSettings",
        "title": "Novel: 開啟設定頁",
        "icon": "$(gear)"
      },
      {
        "command": "novel.openProject",
        "title": "Novel: 開啟工程頁",
        "icon": "$(book)"
      },
      {
        "command": "novel.openLogs",
        "title": "Novel: 開啟日誌頁",
        "icon": "$(output)"
      },
      {
        "command": "novel.showOutputChannel",
        "title": "Novel: 顯示輸出面板日誌"
      },
      {
        "command": "novel.quickContinue",
        "title": "Novel: 快速續寫（不開面板）"
      },
      {
        "command": "novel.summarizePlot",
        "title": "Novel: 同步這一章",
        "icon": "$(book)"
      },
      {
        "command": "novel.syncSummaries",
        "title": "Novel: 照正文更新所有過期細綱"
      },
      {
        "command": "novel.rebuildGlobalSummary",
        "title": "Novel: 重建全文大綱"
      },
      {
        "command": "novel.extractCharacters",
        "title": "Novel: 提取/更新角色卡"
      },
      {
        "command": "novel.recordLore",
        "title": "Novel: 補記設定（同步過、還沒記設定的章）"
      },
      {
        "command": "novel.buildLore",
        "title": "Novel: 給出現過的設定建條目"
      },
      {
        "command": "novel.integrateLore",
        "title": "Novel: 整合設定（把同步過的章裡的新內容並進條目）"
      },
      {
        "command": "novel.organizeLore",
        "title": "Novel: 按目錄整理設定"
      },
      {
        "command": "novel.updateCharacterCard",
        "title": "Novel: 更新某個角色的檔案"
      },
      {
        "command": "novel.extractStyle",
        "title": "Novel: 提取文風指南"
      },
      {
        "command": "novel.openFile",
        "title": "開啟檔案"
      },
      {
        "command": "novel.newCharacter",
        "title": "Novel: 新建角色卡",
        "icon": "$(person-add)"
      },
      {
        "command": "novel.newLore",
        "title": "Novel: 新建設定條目",
        "icon": "$(add)"
      },
      {
        "command": "novel.newFolder",
        "title": "Novel: 新建資料夾",
        "icon": "$(new-folder)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "novel.newSession",
          "when": "view == novelForge.chat",
          "group": "navigation@1"
        },
        {
          "command": "novel.openChatInEditor",
          "when": "view == novelForge.chat",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "novel.addSelectionToChat",
          "when": "editorHasSelection && novelForge.initialized",
          "group": "novelwarden@1"
        }
      ],
      "commandPalette": [
        {
          "command": "novel.openFile",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "novel.addSelectionToChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorHasSelection && novelForge.initialized"
      }
    ],
    "configuration": {
      "title": "Novelwarden",
      "properties": {
        "novel.providers": {
          "type": "array",
          "default": [],
          "markdownDescription": "服務商列表。每個服務商有一個字首 `id`，其下可配置多個模型；模型用 `字首/模型名` 引用（模型名本身可含斜槓，只在第一個斜槓處切分）。留空時會沿用舊版的 `novel.provider` 等設定。",
          "items": {
            "type": "object",
            "required": [
              "id",
              "models"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$",
                "description": "引用字首，不能含斜槓。例如 glm、openrouter、ollama。"
              },
              "label": {
                "type": "string",
                "description": "顯示名，留空則顯示 id。"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "openai",
                  "anthropic",
                  "vscode-lm"
                ],
                "default": "openai",
                "enumDescriptions": [
                  "OpenAI 相容介面（OpenAI / DeepSeek / 智谱 / Kimi / 通义 / OpenRouter / Ollama 等）",
                  "Anthropic Messages API",
                  "VS Code Language Model API（複用 GitHub Copilot 訂閱）"
                ],
                "description": "介面協議。"
              },
              "baseUrl": {
                "type": "string",
                "description": "介面地址，不含末尾斜槓。vscode-lm 無需填寫。"
              },
              "models": {
                "type": "array",
                "description": "該服務商下的模型清單。",
                "items": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "原樣傳給 API 的模型名，可含斜槓，如 z-ai/glm-4.6。"
                    },
                    "label": {
                      "type": "string",
                      "description": "顯示名，留空則顯示模型名。"
                    },
                    "contextWindow": {
                      "type": "number",
                      "description": "該模型的上下文視窗。建議按模型實際規格填寫；留空時使用內建相容值。"
                    },
                    "maxOutputTokens": {
                      "type": "number",
                      "description": "該模型的最大輸出 token。建議按模型實際規格填寫；留空時使用內建相容值。"
                    }
                  }
                }
              }
            }
          },
          "markdownDeprecationMessage": "已遷移至 ~/.novelwarden/config.json，此處僅作相容兜底。"
        },
        "novel.models": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "預設模型列表，按順序，第一個是首選。格式為 `字首/模型名`。工程頁的同步 / 角色卡 / 設定 / 文風任務序列時用第一個，失敗會隨機換用其餘（見 `novel.fallbackAttempts`）；併發時在列表裡輪轉做負載均衡。分檔後它是**所有未配置檔位的兜底清單**（見 `novel.tierModels`）。留空則退化為 `novel.model` 單個模型。",
          "markdownDeprecationMessage": "已遷移至 ~/.novelwarden/config.json，此處僅作相容兜底。"
        },
        "novel.tierModels": {
          "type": "object",
          "default": {},
          "properties": {
            "fast": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "快速檔：便宜、快，用於量大而單次簡單的活。"
            },
            "balanced": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "均衡檔：折中，用於量不小但質量也要緊的活。"
            },
            "quality": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "精標檔：最聰明的模型，用於一次定調、錯了代價大的活。"
            }
          },
          "additionalProperties": false,
          "markdownDescription": "三檔（快速 / 均衡 / 精標）各自的模型清單，格式與 `novel.models` 相同。工程頁任務按 `novel.taskTiers` 歸檔取模型：簡單大量的活走快速檔，困難的活走精標檔。**某一檔留空則該檔的任務沿用 `novel.models`**，三檔都空即不分檔（行為與分檔前一致）。失敗換模型只在**同檔內**發生，絕不跨檔升級。對話頁續寫不看檔位，永遠用 `novel.model`。",
          "markdownDeprecationMessage": "已遷移至 ~/.novelwarden/config.json，此處僅作相容兜底。"
        },
        "novel.taskTiers": {
          "type": "object",
          "default": {},
          "properties": {
            "chapterSummary": {
              "type": "string",
              "enum": [
                "fast",
                "balanced",
                "quality"
              ],
              "description": "同步 · 照正文更新細綱。預設 fast。"
            },
            "globalSummaryStage": {
              "type": "string",
              "enum": [
                "fast",
                "balanced",
                "quality"
              ],
              "description": "全文大綱 · 分批匯總。預設 fast。"
            },
            "globalSummaryMerge": {
              "type": "string",
              "enum": [
                "fast",
                "balanced",
                "quality"
              ],
              "description": "全文大綱 · 最終合併。預設 quality。"
            },
            "loreScan": {
              "type": "string",
              "enum": [
                "fast",
                "balanced",
                "quality"
              ],
              "description": "設定 · 記設定（單獨記一章、補記）。預設 fast。"
            },
            "loreSynthesis": {
              "type": "string",
              "enum": [
                "fast",
                "balanced",
                "quality"
              ],
              "description": "設定 · 建條目、整合與按目錄整理。預設 balanced。"
            },
            "characterCard": {
              "type": "string",
              "enum": [
                "fast",
                "balanced",
                "quality"
              ],
              "description": "角色卡 · 更新 / 建卡。預設 balanced。"
            },
            "extractCharacters": {
              "type": "string",
              "enum": [
                "fast",
                "balanced",
                "quality"
              ],
              "description": "提取角色。預設 quality。"
            },
            "extractStyle": {
              "type": "string",
              "enum": [
                "fast",
                "balanced",
                "quality"
              ],
              "description": "提取文風。預設 quality。"
            }
          },
          "additionalProperties": false,
          "markdownDescription": "每項工程頁任務歸在哪一檔（見 `novel.tierModels`）。只需寫與內建預設不同的項——沒寫的任務跟著內建預設走。內建預設按「呼叫次數 × 單次難度」定：次數多而單次簡單的歸 fast，一次定調的歸 quality。認不出的任務名與非法檔位名一律忽略，那一項回落預設。",
          "markdownDeprecationMessage": "已遷移至 ~/.novelwarden/config.json，此處僅作相容兜底。"
        },
        "novel.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "當前使用的模型，格式為 `字首/模型名`，例如 `glm/glm-4-plus`、`openrouter/z-ai/glm-4.6`。恆等於 `novel.models` 的第一項（對話頁切換模型會把它提到列表首位）。留空則取第一個可用模型。",
          "markdownDeprecationMessage": "已遷移至 ~/.novelwarden/config.json，此處僅作相容兜底。"
        },
        "novel.concurrency": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 16,
          "markdownDescription": "工程頁批次任務（批次同步、重建全文大綱、批次更新角色卡、批次建卡、生成設定）的併發請求數。1 表示序列。調大能顯著縮短等待，但更容易撞上服務商的限流（429）。",
          "markdownDeprecationMessage": "已遷移至 ~/.novelwarden/config.json，此處僅作相容兜底。"
        },
        "novel.fallbackAttempts": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "markdownDescription": "工程頁任務裡一次呼叫失敗後，換用**同檔**其它模型重試的次數上限（檔位見 `novel.tierModels`，未分檔時就是 `novel.models`）。0 表示不重試。該檔裡只有一個模型時不生效，也不會跨檔去找別的模型。",
          "markdownDeprecationMessage": "已遷移至 ~/.novelwarden/config.json，此處僅作相容兜底。"
        },
        "novel.temperature": {
          "type": "number",
          "default": 0.8,
          "minimum": 0,
          "maximum": 2,
          "description": "取樣溫度。寫小說建議 0.7 ~ 1.0。同步與全文大綱這類整理任務內部固定用 0.3。",
          "markdownDeprecationMessage": "已遷移至 ~/.novelwarden/config.json，此處僅作相容兜底。"
        },
        "novel.chaptersDir": {
          "type": "string",
          "default": "chapters",
          "description": "章節正文目錄（相對工作區根目錄）。",
          "markdownDeprecationMessage": "已遷移至 ~/.novelwarden/config.json，此處僅作相容兜底。"
        },
        "novel.draftsDir": {
          "type": "string",
          "default": "drafts",
          "description": "章節草稿目錄（相對工作區根目錄）。每章的草稿按它在章節目錄下的相對路徑映象存放。",
          "markdownDeprecationMessage": "已遷移至 ~/.novelwarden/config.json，此處僅作相容兜底。"
        },
        "novel.summaryBatchSize": {
          "type": "number",
          "default": 15,
          "minimum": 3,
          "description": "重建全文大綱時，每批匯總多少章同步過的細綱。",
          "markdownDeprecationMessage": "已遷移至 ~/.novelwarden/config.json，此處僅作相容兜底。"
        },
        "novel.requestTimeoutMs": {
          "type": "number",
          "default": 300000,
          "minimum": 10000,
          "description": "單次 LLM 請求的空閒超時（毫秒）。流式還在吐字時不計時，卡住這麼久沒資料才中止。",
          "markdownDeprecationMessage": "已遷移至 ~/.novelwarden/config.json，此處僅作相容兜底。"
        },
        "novel.provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "vscode-lm"
          ],
          "default": "openai",
          "markdownDeprecationMessage": "已由 `novel.providers` + `novel.model` 取代。僅在 `novel.providers` 為空時作為相容兜底。",
          "description": "（舊版）使用哪個大模型服務商。"
        },
        "novel.openai.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "markdownDeprecationMessage": "已由 `novel.providers` 中各服務商的 `baseUrl` 取代。",
          "description": "（舊版）OpenAI 相容介面的 baseUrl。"
        },
        "novel.openai.model": {
          "type": "string",
          "default": "gpt-4o",
          "markdownDeprecationMessage": "已由 `novel.providers` 中的模型清單取代。",
          "description": "（舊版）OpenAI 相容介面使用的模型名。"
        },
        "novel.anthropic.baseUrl": {
          "type": "string",
          "default": "https://api.anthropic.com",
          "markdownDeprecationMessage": "已由 `novel.providers` 中各服務商的 `baseUrl` 取代。",
          "description": "（舊版）Anthropic API baseUrl。"
        },
        "novel.anthropic.model": {
          "type": "string",
          "default": "claude-sonnet-4-5",
          "markdownDeprecationMessage": "已由 `novel.providers` 中的模型清單取代。",
          "description": "（舊版）Anthropic 使用的模型名。"
        },
        "novel.vscodeLm.family": {
          "type": "string",
          "default": "gpt-4o",
          "markdownDeprecationMessage": "已由 `novel.providers` 中 kind 為 vscode-lm 的服務商取代。",
          "description": "（舊版）VS Code LM API 選擇的模型 family。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "embed": "node scripts/embed-media.js",
    "media": "node scripts/build-media.js",
    "pretypecheck": "node scripts/embed-media.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p media/tsconfig.json",
    "test:unit": "node --test --test-reporter=./tests/reporters/quiet.mjs \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-reporter=./tests/reporters/quiet.mjs \"tests/integration/**/*.test.js\"",
    "pretest:dom": "node scripts/build-media.js",
    "test:dom": "node --test --test-reporter=./tests/reporters/quiet.mjs \"tests/dom/**/*.test.js\"",
    "test:contract": "node --test --test-reporter=./tests/reporters/quiet.mjs \"tests/contract/**/*.test.js\"",
    "pretest:e2e": "node scripts/embed-media.js",
    "test:e2e": "bun test tests/e2e/",
    "pretest:node": "node scripts/build-media.js",
    "test:node": "node --test --test-reporter=./tests/reporters/quiet.mjs \"tests/{unit,integration,dom,contract}/**/*.test.js\"",
    "test:verbose": "node --test \"tests/{unit,integration,dom,contract}/**/*.test.js\"",
    "presmoke": "node scripts/embed-media.js",
    "smoke": "npm run test:node",
    "test": "npm run typecheck && npm run test:node && npm run test:e2e",
    "preversion": "npm test",
    "standalone": "node scripts/embed-media.js && bun run src/shells/standalone/main.ts",
    "dist": "node scripts/embed-media.js && bun build src/shells/standalone/main.ts --compile --outfile dist/novelwarden",
    "sidecar": "node scripts/build-sidecar.js",
    "sidecar:all": "node scripts/build-sidecar.js all",
    "app:dev": "cd src/shells/desktop && tauri dev",
    "app:build": "cd src/shells/desktop && tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.23.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "ws": "^8.22.0"
  },
  "bin": {
    "novelwarden": "./bin/novelwarden.js",
    "novelforge": "./bin/novelwarden.js"
  }
