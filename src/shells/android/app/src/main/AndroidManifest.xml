<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 本機模式：寫一章要幾分鐘，切到後臺時系統會凍住 app 連同內建的 node；前臺服務（常駐通知）讓它接著跑 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 書放在 Documents/NovelForge：別的 app（檔案管理、同步盤）也看得到。內建服務端是 node，只認檔案路徑、
         不認 content:// 那一套，所以 Android 11+ 要「所有檔案訪問」，10 及以下要寫儲存許可權。不給就放在 app 自己的目錄 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- usesCleartextTraffic：內建服務端走 http://127.0.0.1，远程模式也允许局域网 http 服務端。
         requestLegacyExternalStorage：Android 10 上沒有「所有檔案訪問」，靠它按路徑讀寫公共目錄 -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <!-- configChanges：旋轉、深色模式切換等不重建 Activity，頁面與編輯中的內容原樣保留 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="本機寫作服務：生成章節期間保持內建服務端執行" />
        </service>
    </application>
</manifest>
