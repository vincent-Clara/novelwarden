{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Novelwarden",
  "version": "../../../package.json",
  "identifier": "com.novelforge.desktop",
  "build": {
    "frontendDist": "ui",
    "beforeDevCommand": "npm run sidecar",
    "beforeBuildCommand": "npm run sidecar"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Novelwarden",
        "url": "splash.html",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/novelwarden"],
    "shortDescription": "長篇小說上下文管理",
    "longDescription": "為長篇小說寫作提供上下文注入、綱要擴寫與角色/劇情整合總結的桌面應用。",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
