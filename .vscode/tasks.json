{
  // 每個殼一條構建任務，命令與 package.json 的 scripts 一一對應（不在這裡另寫一份
  // 命令列——那樣兩處會漂）。哪條任務服務哪個啟動配置，見 .vscode/README.md。
  "version": "2.0.0",
  "tasks": [
    {
      // 預設構建任務，外掛殼的兩條 launch 都靠它（${defaultBuildTask}）。
      // esbuild.js 會連 media/src → dist/media/ 一起監聽，漏了 webview 會 404。
      "label": "watch",
      "type": "npm",
      "script": "watch",
      "problemMatcher": "$esbuild-watch",
      "isBackground": true,
      "presentation": { "reveal": "never" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "外掛：一次性編譯",
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$esbuild",
      "presentation": { "reveal": "silent" },
      "group": "build"
    },
    {
      // 只監聽前端產物。改 media/src/ 時夠用，比整個 watch 輕。
      // 獨立版的頁面資源也來自這裡（經 embed-media 內嵌），但**改完要重啟服務**
      // ——mediaAssets.ts 是啟動時讀進記憶體的。
      "label": "前端：監聽構建（media/src → dist/media）",
      "type": "shell",
      "command": "node scripts/build-media.js --watch",
      "isBackground": true,
      "problemMatcher": "$esbuild-watch",
      "presentation": { "reveal": "never" },
      "group": "build"
    },
    {
      // 獨立版/單檔案的前置：把 dist/media 的產物 base64 內嵌進
      // src/shells/standalone/mediaAssets.ts（生成檔案，已 gitignore）。
      "label": "獨立版：內嵌前端資源",
      "type": "npm",
      "script": "embed",
      "problemMatcher": [],
      "presentation": { "reveal": "silent" },
      "group": "build"
    },
    {
      // 「跑單檔案可執行」那條 launch 的 preLaunchTask。npm run dist 自帶 embed。
      "label": "獨立版：編譯單檔案",
      "type": "npm",
      "script": "dist",
      "problemMatcher": [],
      "presentation": { "reveal": "always" },
      "group": "build"
    },
    {
      // 桌面殼的 sidecar（當前平臺）。app:dev / app:build 會自己觸發，
      // 這條是"只想單獨編一次 sidecar"時用。
      "label": "桌面版：編譯 sidecar（當前平臺）",
      "type": "npm",
      "script": "sidecar",
      "problemMatcher": [],
      "presentation": { "reveal": "always" },
      "group": "build"
    },
    {
      "label": "桌面版：編譯 sidecar（含 Windows 交叉編譯）",
      "type": "npm",
      "script": "sidecar:all",
      "problemMatcher": [],
      "presentation": { "reveal": "always" },
      "group": "build"
    },
    {
      "label": "桌面版：出安裝包",
      "type": "npm",
      "script": "app:build",
      "problemMatcher": [],
      "presentation": { "reveal": "always" },
      "group": "build"
    },
    {
      "label": "typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": "$tsc",
      "presentation": { "reveal": "silent" },
      "group": "build"
    },
    {
      "label": "測試：全部",
      "type": "npm",
      "script": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always" },
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "測試：unit",
      "type": "npm",
      "script": "test:unit",
      "problemMatcher": [],
      "presentation": { "reveal": "always" },
      "group": "test"
    },
    {
      "label": "測試：integration",
      "type": "npm",
      "script": "test:integration",
      "problemMatcher": [],
      "presentation": { "reveal": "always" },
      "group": "test"
    },
    {
      "label": "測試：dom",
      "type": "npm",
      "script": "test:dom",
      "problemMatcher": [],
      "presentation": { "reveal": "always" },
      "group": "test"
    },
    {
      // 獨立版的真 HTTP/WS 服務，需要 Bun。
      "label": "測試：e2e（需 Bun）",
      "type": "npm",
      "script": "test:e2e",
      "problemMatcher": [],
      "presentation": { "reveal": "always" },
      "group": "test"
    },
    {
      // 架構不變式：core 零 vscode 依賴、殼之間不互相 import、沒有"我是哪個殼"的分支。
      "label": "測試：contract（架構不變式）",
      "type": "npm",
      "script": "test:contract",
      "problemMatcher": [],
      "presentation": { "reveal": "always" },
      "group": "test"
    }
  ]
}
