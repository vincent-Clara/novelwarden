node_modules/
# 全部構建產物都在這裡：dist/extension.js、dist/media/（前端，原始碼在 media/src/）、
# dist/novelwarden（單檔案可執行）。一處都不入庫。
dist/
out/
*.vsix
.DS_Store

src/shells/standalone/mediaAssets.ts
src/core/skills/builtin/embedded.ts
sample-novel/.novelwarden/sessions
sample-novel/.novelforge/sessions

# 工程資料庫（失敗記錄 + 日誌歷史）。它是可丟棄的痕跡，不是內容——
# 內容一律是 Markdown。WAL 模式還會帶出 -wal / -shm 兩個附屬檔案。
*.db
*.db-wal
*.db-shm

.claude/
.cursor/
temp/
local/

# git worktree 隔離目錄（見 .worktrees/）
.worktrees/

# 桌面殼的構建產物：sidecar 可執行檔案（由 scripts/build-sidecar.js 生成，
# 與 dist/novelwarden 同源）與 Rust 編譯中間產物。殼的原始碼本身是入庫的。
src/shells/desktop/binaries/
src/shells/desktop/target/